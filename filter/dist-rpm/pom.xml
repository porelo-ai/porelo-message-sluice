<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.fuin.porelo</groupId>
        <artifactId>porelo-message-sluice-filter-parent</artifactId>
        <version>0.5.1-SNAPSHOT</version>
    </parent>

    <artifactId>porelo-message-sluice-filter-rpm</artifactId>
    <packaging>pom</packaging>
    <name>porelo-message-sluice-filter (.rpm)</name>
    <description>The .rpm package of porelo-message-sluice-filter</description>

    <!-- The native binary is not a Maven artifact, so it is found by path. The dependency only puts
         this module after the one that builds it. -->

    <dependencies>
        <dependency>
            <groupId>org.fuin.porelo</groupId>
            <artifactId>porelo-message-sluice-filter</artifactId>
            <version>${project.version}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
            </plugin>

            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
            </plugin>

            <!-- On verify, as the .deb. Release 1 and the same version for a snapshot, or a snapshot gets
                 a timestamp release and the rpm and the deb disagree about which version they are. -->

            <plugin>
                <groupId>de.dentrassi.maven</groupId>
                <artifactId>rpm</artifactId>
                <executions>
                    <execution>
                        <id>rpm</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>rpm</goal>
                        </goals>
                        <configuration>
                            <packageName>porelo-message-sluice-filter</packageName>
                            <outputFileName>porelo-message-sluice-filter-${sluice.package.version}-1.x86_64.rpm</outputFileName>
                            <version>${sluice.package.version}</version>
                            <snapshotVersion>${sluice.package.version}</snapshotVersion>
                            <release>1</release>
                            <forceRelease>true</forceRelease>
                            <architecture>x86_64</architecture>
                            <group>Applications/System</group>
                            <license>GPL-3.0-or-later</license>
                            <summary>Refuses an outgoing agent message that carries data</summary>
                            <description>The filter Porelo runs over every message a task sends: only plain English prose passes.</description>
                            <evalHostname>false</evalHostname>
                            <skipSigning>true</skipSigning>
                            <attach>false</attach>
                            <!-- The names rpmbuild itself would generate from the binary. -->
                            <requires>
                                <require>porelo</require>
                                <require>libc.so.6(GLIBC_${sluice.glibc.floor})(64bit)</require>
                                <require>libz.so.1(ZLIB_${sluice.zlib.floor})(64bit)</require>
                            </requires>
                            <entries>
                                <entry>
                                    <name>/usr/libexec/porelo/porelo-message-sluice-filter</name>
                                    <file>${project.basedir}/../app/target/porelo-message-sluice-filter</file>
                                    <user>root</user>
                                    <group>root</group>
                                    <mode>0755</mode>
                                </entry>
                                <entry>
                                    <name>/usr/share/doc/porelo-message-sluice-filter/bom.json</name>
                                    <file>${project.basedir}/../app/target/bom.json</file>
                                    <user>root</user>
                                    <group>root</group>
                                    <mode>0644</mode>
                                    <documentation>true</documentation>
                                </entry>
                                <entry>
                                    <name>/usr/share/licenses/porelo-message-sluice-filter/LICENSE</name>
                                    <file>${project.basedir}/../../LICENSE</file>
                                    <user>root</user>
                                    <group>root</group>
                                    <mode>0644</mode>
                                    <license>true</license>
                                </entry>
                            </entries>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- After both packages are written, the versions read back out of them (PackageVersionIT, from
                 dist-common): this module is the reactor's last, so the .deb is there too. A pom module
                 binds no compile or failsafe of its own, so both are bound here; the root's LinkageIT run
                 belongs to the app module and is switched off. -->

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <executions>
                    <execution>
                        <id>package-check-compile</id>
                        <phase>test-compile</phase>
                        <goals>
                            <goal>testCompile</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <executions>
                    <execution>
                        <id>linkage</id>
                        <phase>none</phase>
                    </execution>
                    <execution>
                        <id>package-version</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                        <configuration>
                            <includes>
                                <include>**/PackageVersionIT.java</include>
                            </includes>
                            <systemPropertyVariables>
                                <sluice.project.version>${project.version}</sluice.project.version>
                                <sluice.snapshot.run>${sluice.snapshot.run}</sluice.snapshot.run>
                                <sluice.deb>${project.basedir}/../dist-deb/target/porelo-message-sluice-filter_${sluice.package.version}_amd64.deb</sluice.deb>
                                <sluice.rpm>${project.build.directory}/porelo-message-sluice-filter-${sluice.package.version}-1.x86_64.rpm</sluice.rpm>
                            </systemPropertyVariables>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

        </plugins>
    </build>

</project>
